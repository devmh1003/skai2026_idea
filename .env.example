# HF Inference API 백엔드용 토큰 (https://huggingface.co/settings/tokens)
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxx

# 사용할 A.X 모델 (기본: skt/A.X-3.1-Light)
CONTRACT_REVIEW_MODEL=skt/A.X-3.1-Light

# 백엔드: auto | local | pipeline | hf_api | adot_biz | offline
CONTRACT_REVIEW_BACKEND=auto

# --- SKT A.Biz(에이닷 비즈) 사내 게이트웨이 연계 ---
# 계약서 원문을 사외로 내보내지 않고 A.X 모델을 쓰려면 이쪽을 채우십시오.
# ADOT_BIZ_BASE_URL=https://<사내-게이트웨이>/v1
# ADOT_BIZ_API_KEY=<발급키>
# ADOT_BIZ_MODEL=ax-3.1-light
# ADOT_BIZ_AGENT_ID=contract-review
